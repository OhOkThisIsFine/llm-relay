{
  "name": "repair-proxy",
  "version": "0.0.1",
  "description": "Loopback Anthropic-Messages-API proxy that validates tool-call responses and (later) reshapes protocol failures, so the Claude Code harness can run on any backend model.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "repair-proxy": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "llm-bridge": "^2.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
