{
  "name": "llm-relay",
  "version": "0.4.0",
  "description": "Loopback Anthropic-Messages-API proxy that validates and repairs tool-call responses in flight, routing across multi-provider LLM backends.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "llm-relay": "dist/cli.js"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OhOkThisIsFine/llm-relay.git"
  },
  "files": [
    "dist",
    "docs/tier-data.json",
    "README.md",
    "config.example.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "sync:tiers": "node scripts/sync-tiers.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "llm-bridge": "^2.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "hyparquet": "^1.26.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
