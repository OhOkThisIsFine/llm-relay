{
  "listen": "127.0.0.1:8791",
  "backend": {
    "base": "http://127.0.0.1:4000",
    "authEnv": "LITELLM_API_KEY",
    "authHeader": "authorization"
  },
  "reshaper": {
    "base": "http://127.0.0.1:4000",
    "model": "reshaper",
    "kind": "anthropic",
    "authEnv": "LITELLM_API_KEY",
    "authHeader": "authorization"
  },
  "mode": "repair",
  "repair": {
    "maxAttempts": 2,
    "destructiveTools": ["rm", "delete", "push", "force", "overwrite", "drop", "reset"]
  },
  "log": { "level": "metadata", "file": null }
}
