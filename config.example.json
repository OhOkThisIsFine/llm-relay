{
  "listen": "127.0.0.1:8791",
  "providers": {
    "nim": {
      "base": "https://integrate.api.nvidia.com/v1",
      "kind": "openai",
      "authEnv": "NVIDIA_API_KEY",
      "tierType": "free"
    },
    "openrouter": {
      "base": "https://openrouter.ai/api/v1",
      "kind": "openai",
      "authEnv": "OPENROUTER_API_KEY",
      "tierType": "mixed"
    },
    "gemini": {
      "base": "https://generativelanguage.googleapis.com/v1beta/openai",
      "kind": "openai",
      "authEnv": "GEMINI_API_KEY",
      "tierType": "free"
    },
    "groq": {
      "base": "https://api.groq.com/openai/v1",
      "kind": "openai",
      "authEnv": "GROQ_API_KEY",
      "tierType": "free"
    },
    "mistral": {
      "base": "https://api.mistral.ai/v1",
      "kind": "openai",
      "authEnv": "MISTRAL_API_KEY",
      "tierType": "free"
    },
    "ollama": {
      "base": "http://localhost:11434/v1",
      "kind": "openai",
      "tierType": "free"
    }
  },
  "routing": {
    "default": [
      "groq/llama-3.3-70b-versatile",
      "openrouter/openrouter/free",
      "nim/z-ai/glm-5.2",
      "gemini/gemini-2.5-flash",
      "ollama/qwen2.5-coder:32b"
    ],
    "tiers": {
      "opus": [
        "nim/nvidia/nemotron-3-super-120b-a12b",
        "gemini/gemini-2.5-pro"
      ],
      "sonnet": [
        "groq/llama-3.3-70b-versatile",
        "nim/z-ai/glm-5.2",
        "gemini/gemini-2.5-flash",
        "ollama/qwen2.5-coder:32b"
      ],
      "haiku": [
        "groq/llama-3.1-8b-instant",
        "nim/meta/llama-3.1-8b-instruct",
        "openrouter/openrouter/free",
        "ollama/deepseek-r1:14b"
      ],
      "fable": [
        "groq/llama-3.1-8b-instant",
        "ollama/deepseek-r1:14b"
      ]
    },
    "pools": {
      "coding": {
        "preferred": ["nim/z-ai/glm-5.2", "groq/llama-3.3-70b-versatile"],
        "include": "free"
      },
      "reasoning": {
        "preferred": ["nim/nvidia/nemotron-3-super-120b-a12b", "gemini/gemini-2.5-pro"],
        "include": "free"
      },
      "fast": {
        "preferred": ["groq/llama-3.1-8b-instant", "nim/meta/llama-3.1-8b-instruct"],
        "include": "free"
      }
    },
    "subagents": {
      "opus": "pool/reasoning",
      "sonnet": "pool/coding",
      "haiku": "pool/fast",
      "fable": "pool/fast",
      "default": "pool/coding"
    },
    "offload": {
      "claude": { "enabled": false, "scope": "subagents" },
      "codex": { "enabled": false, "scope": "subagents" }
    }
  },
  "mode": "repair",
  "repair": {
    "maxAttempts": 2,
    "destructiveTools": [
      "Bash",
      "BashOutput",
      "Write",
      "Edit",
      "MultiEdit",
      "NotebookEdit",
      "rm",
      "delete",
      "delete_file",
      "remove",
      "overwrite",
      "drop",
      "reset",
      "force_push"
    ]
  },
  "log": {
    "level": "metadata",
    "file": null
  }
}
