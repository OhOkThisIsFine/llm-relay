{
  "listen": "127.0.0.1:8791",
  "providers": {
    "nim": {
      "base": "https://integrate.api.nvidia.com/v1",
      "kind": "openai",
      "credentials": [
        { "label": "personal", "authEnv": "NVIDIA_API_KEY" },
        { "label": "work", "authEnv": "NVIDIA_WORK_API_KEY" }
      ],
      "tierType": "free"
    },
    "openrouter": {
      "base": "https://openrouter.ai/api/v1",
      "kind": "openai",
      "authEnv": "OPENROUTER_API_KEY",
      "tierType": "mixed"
    },
    "gemini": {
      "base": "https://generativelanguage.googleapis.com/v1beta/openai",
      "kind": "openai",
      "authEnv": "GEMINI_API_KEY",
      "tierType": "free"
    },
    "groq": {
      "base": "https://api.groq.com/openai/v1",
      "kind": "openai",
      "authEnv": "GROQ_API_KEY",
      "tierType": "free"
    },
    "mistral": {
      "base": "https://api.mistral.ai/v1",
      "kind": "openai",
      "authEnv": "MISTRAL_API_KEY",
      "tierType": "free"
    },
    "ollama": {
      "base": "http://localhost:11434/v1",
      "kind": "openai",
      "tierType": "free"
    }
  },
  "routing": {
    "default": "pool/medium",
    "tiers": {
      "opus": "pool/xhigh",
      "fable": "pool/xhigh",
      "sonnet": "pool/high",
      "haiku": "pool/medium"
    },
    "pools": {
      "low": {
        "preferred": [],
        "include": "free",
        "effort": "low"
      },
      "medium": {
        "preferred": [],
        "include": "free",
        "effort": "medium"
      },
      "high": {
        "preferred": [],
        "include": "free",
        "effort": "high"
      },
      "xhigh": {
        "preferred": [],
        "include": "free",
        "effort": "xhigh"
      }
    },
    "subagents": {
      "opus": "pool/xhigh",
      "sonnet": "pool/high",
      "haiku": "pool/medium",
      "fable": "pool/xhigh",
      "default": "pool/medium"
    },
    "offload": {
      "claude": { "enabled": false, "scope": "subagents" },
      "codex": { "enabled": false, "scope": "subagents" }
    },
    "sticky": false
  },
  "mode": "repair",
  "repair": {
    "maxAttempts": 2,
    "destructiveTools": [
      "Bash",
      "BashOutput",
      "Write",
      "Edit",
      "MultiEdit",
      "NotebookEdit",
      "shell_command",
      "apply_patch",
      "rm",
      "delete",
      "delete_file",
      "remove",
      "overwrite",
      "drop",
      "reset",
      "force_push"
    ]
  },
  "log": {
    "level": "metadata",
    "file": null
  }
}
